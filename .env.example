# Токен от @BotFather
BOT_TOKEN=123456789:AAAA...

# Telegram ID пользователей, которым разрешён доступ (через запятую).
# Свой ID можно узнать, написав боту — он ответит "Доступ запрещён, ваш ID: ..."
ALLOWED_USER_IDS=111111111

# ===== Сервер WireGuard (angristan/wireguard-install) =====
# SSH-доступ к серверу с WireGuard
SSH_HOST=1.2.3.4
SSH_PORT=22
SSH_USER=root
# Либо пароль, либо путь к приватному ключу (ключ надёжнее)
SSH_PASSWORD=
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
# Путь к known_hosts для проверки ключа сервера. Пусто — без проверки.
SSH_KNOWN_HOSTS=

# Куда класть конфиги клиентов на сервере (wireguard-install.sh кладёт в /root)
WG_CLIENTS_DIR=/root
# Название сервера в кнопках бота
WG_SERVER_NAME=WireGuard

# ===== Второй сервер: Amnezia VPN (Docker, протокол AmneziaWG) =====
# Оставьте AMNEZIA_SSH_HOST пустым, если этот сервер не нужен.
# Если не нужен сервер WireGuard выше — оставьте пустым SSH_HOST.
AMNEZIA_SERVER_NAME=Amnezia
AMNEZIA_SSH_HOST=
AMNEZIA_SSH_PORT=22
AMNEZIA_SSH_USER=root
AMNEZIA_SSH_PASSWORD=
AMNEZIA_SSH_KEY_PATH=
AMNEZIA_SSH_KEY_PASSPHRASE=
AMNEZIA_SSH_KNOWN_HOSTS=
# Имя Docker-контейнера AmneziaWG (см. docker ps) и каталог с конфигами внутри него
AMNEZIA_CONTAINER=amnezia-awg
AMNEZIA_AWG_DIR=/opt/amnezia/awg
# Адрес сервера для клиентов (Endpoint). Пусто — берётся AMNEZIA_SSH_HOST
AMNEZIA_ENDPOINT=
# DNS в клиентских конфигах
AMNEZIA_DNS=1.1.1.1, 1.0.0.1
